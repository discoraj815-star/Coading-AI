# Gemini API Configuration
GEMINI_API_KEY=""

# Gemini Model Router Mappings (Configurable Logical Roles)
GEMINI_MODEL_FAST_MULTIMODAL="gemini-3.8-flash"
GEMINI_MODEL_VISUAL_ANALYSIS="gemini-3.8-flash"
GEMINI_MODEL_AUDIO_ANALYSIS="gemini-3.8-flash"
GEMINI_MODEL_REASONING="gemini-3.1-pro-preview"
GEMINI_MODEL_KNOWLEDGE_SYNTHESIS="gemini-3.8-flash"
GEMINI_MODEL_EMBEDDING="gemini-embedding-2"
GEMINI_MODEL_FUTURE_LIVE="gemini-3.8-flash"

# System Configuration
APP_ENV="development"
LOG_LEVEL="INFO"
DATA_DIR="data"
DB_PATH="data/trading_ai.db"
UPLOAD_DIR="data/uploads"
FRAMES_DIR="data/frames"

# Token Management Settings
TOKEN_DEFAULT_INPUT_BUDGET=30000
TOKEN_DEFAULT_OUTPUT_RESERVE=4000
TOKEN_SAFETY_MARGIN_PERCENT=0.20
MAX_CHUNK_DURATION_SECONDS=60
